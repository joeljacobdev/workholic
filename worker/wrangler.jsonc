{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workholic",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  // workaholic.joeljacob.tech is a custom domain owned by Terraform
  // (~/code/infra/deployments/cloudflare/main.tf), so there are no routes here.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // WORKHOLIC_BOOTSTRAP_TOKEN is a secret: `wrangler secret put`, and .dev.vars locally.
  "assets": {
    "directory": "./public"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "USER", "class_name": "UserAccount" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Directory", "UserAccount"]
    }
  ]
}
